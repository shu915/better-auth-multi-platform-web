BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# JWT audience; must match the value the Go API verifies (optional)
JWT_AUDIENCE=better-auth-multi-platform-api
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# "console" logs emails, "resend" sends them (required in production)
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=
