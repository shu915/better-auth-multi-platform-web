BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# JWT audience; must match the value the Go API verifies (optional)
JWT_AUDIENCE=better-auth-multi-platform-api
# Base URL of the Go API (defaults to http://localhost:8080 outside production; required in production)
API_BASE_URL=http://localhost:8080
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Google login (optional). Set both to enable it; setting only one is an error.
# Authorized redirect URI in Google Cloud Console: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "console" logs emails, "resend" sends them (required in production)
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=
